page 101 (
    name: Liste des Sites
    alias: HQ-SITES
    title: Gestion des Sites
    pageGroup: @hq
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Liste et configuration de tous les sites de la chaîne.</p>
            <p>HQ / Dépôts / Supermarchés - leur rattachement hiérarchique.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source { breadcrumb: @breadcrumb }
        layout { sequence: 20; slot: breadcrumbBar }
        appearance {
            template: @/title-bar
            templateOptions: [ #DEFAULT# t-BreadcrumbRegion--useBreadcrumbTitle ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region liste-sites (
        name: Sites
        type: interactiveReport
        source { location: localDatabase; tableName: TES-SITE }
        layout { sequence: 10; slot: body }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc ]
        }
        link {
            linkColumn: customTarget
            target: { page: 102; items: { P102_ID: \#ID#\ }; action: resetPagination }
            linkIcon: <span class="fa fa-edit"></span>
        }
        pagination { type: rowRangesXToY }
        messages {
            whenNoDataFound: Aucun site configuré.
        }

        column ID ( type: hidden; layout { sequence: 0 } source { primaryKey: true; dataType: NUMBER } )
        column SITE_CODE ( type: plainText; heading { heading: Code } layout { sequence: 1 } source { dataType: STRING } )
        column SITE_NAME ( type: plainText; heading { heading: Nom } layout { sequence: 2 } source { dataType: STRING } )
        column SITE_TYPE ( type: plainText; heading { heading: Type } layout { sequence: 3 } source { dataType: STRING } )
        column PARENT_SITE_ID ( type: plainText; heading { heading: Rattaché à } layout { sequence: 4 } source { dataType: STRING } )
        column CITY ( type: plainText; heading { heading: Ville } layout { sequence: 5 } source { dataType: STRING } )
        column PHONE ( type: plainText; heading { heading: Téléphone } layout { sequence: 6 } source { dataType: STRING } )
        column ACTIVE ( type: plainText; heading { heading: Actif } layout { sequence: 7 } source { dataType: STRING } )

        savedReport primary (
            visibility: primaryDefault
            view { rowsPerPage: 50 }
            sort ( column: SITE_TYPE; sort { sequence: 1 } )
        )
    )

    button create-site (
        buttonName: CREATE
        label: Nouveau Site
        layout {
            sequence: 10
            region: @liste-sites
            slot: rightOfInteractiveReportSearchBar
        }
        appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# }
        behavior {
            action: redirectThisApp
            target: { page: 102; clearCache: 102 }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Closed
        execution { sequence: 10 }
        when { event: apexafterclosedialog; selectionType: region; region: @liste-sites }
        action native-refresh (
            action: refresh
            affectedElements { selectionType: region; region: @liste-sites }
            execution { sequence: 10; fireOnInit: false }
        )
    )

)