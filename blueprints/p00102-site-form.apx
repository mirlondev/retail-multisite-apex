page 102 (
    name: Site Form
    alias: HQ-SITE-FORM
    title: Fiche Site
    pageGroup: @hq
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [ #DEFAULT# js-dialog-class-t-Drawer--pullOutEnd ]
    }
    dialog { chained: false }
    navigation { cursorFocus: doNotFocusCursor }
    security { pageAccessProtection: argumentsMustHaveChecksum; formAutoComplete: false }

    region buttons ( name: Buttons; type: staticContent; layout { sequence: 20; slot: dialogFooter } appearance { template: @/buttons-container; templateOptions: #DEFAULT# } )

    region site-form (
        name: Site
        type: form
        source { location: localDatabase; tableName: TES-SITE }
        layout { sequence: 10; slot: contentBody }
        appearance { template: @/blank-with-attributes; templateOptions: #DEFAULT# }
        edit { enabled: true; allowedOperations: [ add update delete ] }
    )

    pageItem P102_ID ( type: hidden; layout { sequence: 10; region: @site-form; slot: regionBody } source { formRegion: @site-form; column: ID; dataType: number; queryOnly: true; primaryKey: true } security { sessionStateProtection: checksumRequiredSessionLevel } )
    pageItem P102_SITE_CODE ( type: textField; label { label: Code Site; alignment: right } layout { sequence: 20; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } validation { maxLength: 20; required: true } source { formRegion: @site-form; column: SITE_CODE; dataType: varchar2 } )
    pageItem P102_SITE_NAME ( type: textField; label { label: Nom du site; alignment: right } layout { sequence: 30; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 200; required: true } source { formRegion: @site-form; column: SITE_NAME; dataType: varchar2 } )
    pageItem P102_SITE_TYPE ( type: selectList; label { label: Type de site; alignment: right } layout { sequence: 40; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } lov { staticValues: [
        { returnValue: HEAD_OFFICE; displayValue: Siège (HQ) }
        { returnValue: DEPOT_PRINCIPAL; displayValue: Dépôt principal }
        { returnValue: DEPOT_SM; displayValue: Dépôt supermarché }
        { returnValue: SUPERMARKET; displayValue: Supermarché }
    ] } source { formRegion: @site-form; column: SITE_TYPE; dataType: varchar2 } validation { required: true } )
    pageItem P102_PARENT_SITE_ID ( type: popupKeyLOV; label { label: Rattaché à; alignment: right } layout { sequence: 50; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } source { formRegion: @site-form; column: PARENT_SITE_ID; dataType: number; lov: { query: SELECT ID, SITE_NAME FROM "TES-SITE" WHERE SITE_TYPE IN ('HEAD_OFFICE','DEPOT_PRINCIPAL','DEPOT_SM') ORDER BY SITE_TYPE, SITE_NAME } } )
    pageItem P102_ADDRESS ( type: textField; label { label: Adresse; alignment: right } layout { sequence: 60; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 255 } source { formRegion: @site-form; column: ADDRESS; dataType: varchar2 } )
    pageItem P102_CITY ( type: textField; label { label: Ville; alignment: right } layout { sequence: 70; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 100 } source { formRegion: @site-form; column: CITY; dataType: varchar2 } )
    pageItem P102_ZIP_CODE ( type: textField; label { label: Code postal; alignment: right } layout { sequence: 80; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } validation { maxLength: 20 } source { formRegion: @site-form; column: ZIP_CODE; dataType: varchar2 } )
    pageItem P102_PHONE ( type: textField; label { label: Téléphone; alignment: right } layout { sequence: 90; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } validation { maxLength: 30 } source { formRegion: @site-form; column: PHONE; dataType: varchar2 } )
    pageItem P102_EMAIL ( type: textField; label { label: Email; alignment: right } layout { sequence: 100; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 200; checkFormat: email } source { formRegion: @site-form; column: EMAIL; dataType: varchar2 } )
    pageItem P102_RESP_NAME ( type: textField; label { label: Responsable; alignment: right } layout { sequence: 110; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 200 } source { formRegion: @site-form; column: RESP_NAME; dataType: varchar2 } )
    pageItem P102_ACTIVE ( type: selectList; label { label: Actif; alignment: right } layout { sequence: 120; region: @site-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } lov { staticValues: [ { returnValue: Y; displayValue: Oui } { returnValue: N; displayValue: Non } ] } source { formRegion: @site-form; column: ACTIVE; dataType: varchar2 } )

    button cancel ( buttonName: CANCEL; label: Cancel; layout { sequence: 10; region: @buttons; slot: close } appearance { buttonTemplate: @/text; templateOptions: #DEFAULT# } behavior { action: triggerAction } triggerAction native-dialog-cancel ( action: cancelDialog; execution { sequence: 10 } ) )
    button create ( buttonName: CREATE; label: Créer; layout { sequence: 40; region: @buttons; slot: next } appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# } behavior { warnOnUnsavedChanges: doNotCheck; databaseAction: insert } serverSideCondition { type: itemIsNull; item: P102_ID } )
    button delete ( buttonName: DELETE; label: Supprimer; layout { sequence: 20; region: @buttons; slot: delete } appearance { buttonTemplate: @/text; templateOptions: [ #DEFAULT# t-Button--danger t-Button--simple ] } behavior { executeValidations: false; warnOnUnsavedChanges: doNotCheck; databaseAction: delete; requiresConfirmation: true } confirmation { message: &APP_TEXT$DELETE_MSG!RAW.; style: danger } serverSideCondition { type: itemIsNotNull; item: P102_ID } )
    button save ( buttonName: SAVE; label: Enregistrer; layout { sequence: 30; region: @buttons; slot: next } appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# } behavior { warnOnUnsavedChanges: doNotCheck; databaseAction: update } serverSideCondition { type: itemIsNotNull; item: P102_ID } )

    process close-dialog ( name: Close Dialog; type: closeDialog; execution { sequence: 50 } serverSideCondition { type: requestIsContainedInValue; value: CREATE,SAVE,DELETE } )
    process initialize-form ( name: Initialize form Site; type: formInitialization; formRegion: @site-form; execution { sequence: 10; point: beforeHeader } )
    process process-form ( name: Process form Site; type: formAutoRowProcessing; formRegion: @site-form; execution { sequence: 10 } )
)