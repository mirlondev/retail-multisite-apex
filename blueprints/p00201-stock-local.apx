page 201 (
    name: Stock Local
    alias: SM-STOCK-LOCAL
    title: Mon Stock Local
    pageGroup: @supermarche
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Stock du site courant uniquement (filtré par SITE_ID).</p>
            <p>Alertes en rouge : stock physique &le; stock minimum.</p>
            <p>Pour ajuster (inventaire) : aller sur la page "Inventaire".</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [ #DEFAULT# t-BreadcrumbRegion--useBreadcrumbTitle ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kpi-resume (
        name: Résumé du stock
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_total      NUMBER := 0;
                    v_rupture    NUMBER := 0;
                    v_alerte     NUMBER := 0;
                    v_transit    NUMBER := 0;
                    v_commande   NUMBER := 0;
                    v_valeur     NUMBER := 0;
                BEGIN
                    SELECT COUNT(*),
                           SUM(CASE WHEN NVL(QTEPHYSIQUE,0) <= 0 THEN 1 ELSE 0 END),
                           SUM(CASE WHEN NVL(QTEPHYSIQUE,0) > 0 AND NVL(QTEPHYSIQUE,0) <= NVL(QTEMIN, NVL(QTESEC,0)) THEN 1 ELSE 0 END),
                           SUM(NVL(QTEENTRANSIT,0)),
                           SUM(NVL(QTECOMMANDE,0))
                      INTO v_total, v_rupture, v_alerte, v_transit, v_commande
                      FROM "TES-STOCK-SITE"
                     WHERE SITE_ID = pkg_multisite_core.current_site;

                    htp.p('<div class="u-info-grid">');
                    htp.p('  <div><b>' || v_total || '</b><br>références</div>');
                    htp.p('  <div style="color:red"><b>' || v_rupture || '</b><br>ruptures</div>');
                    htp.p('  <div style="color:orange"><b>' || v_alerte || '</b><br>alertes</div>');
                    htp.p('  <div><b>' || v_transit || '</b><br>en transit</div>');
                    htp.p('  <div><b>' || v_commande || '</b><br>commandés</div>');
                    htp.p('</div>');
                END;
                ```
        }
    )

    region stock-list (
        name: Stock
        type: interactiveReport
        source {
            location: localDatabase
            tableName: TES-STOCK-SITE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_FILTER_SITE
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucun stock. Lancez un inventaire ou demandez un transfert.
        }

        column ID (
            type: hidden
            layout {
            sequence: 0
        } source {
            primaryKey: true
            dataType: NUMBER
        } )
        column CODART (
            type: plainText
            heading {
            heading: Code Article
        } layout {
            sequence: 1
        } source {
            dataType: STRING
        } )
        column QTEPHYSIQUE (
            type: plainText
            heading {
            heading: Phys.
            alignment: end
        } layout {
            sequence: 2
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTETHEORIQUE (
            type: plainText
            heading {
            heading: Théo.
            alignment: end
        } layout {
            sequence: 3
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTEENTRANSIT (
            type: plainText
            heading {
            heading: Transit
            alignment: end
        } layout {
            sequence: 4
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTECOMMANDE (
            type: plainText
            heading {
            heading: Commandé
            alignment: end
        } layout {
            sequence: 5
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTEMIN (
            type: plainText
            heading {
            heading: Min
            alignment: end
        } layout {
            sequence: 6
            columnAlignment: end
        } source {
            dataType: NUMBER
        } )
        column QTEMAX (
            type: plainText
            heading {
            heading: Max
            alignment: end
        } layout {
            sequence: 7
            columnAlignment: end
        } source {
            dataType: NUMBER
        } )
        column QTESEC (
            type: plainText
            heading {
            heading: Sécur.
            alignment: end
        } layout {
            sequence: 8
            columnAlignment: end
        } source {
            dataType: NUMBER
        } )
        column DERNIER_MVT (
            type: plainText
            heading {
            heading: Dernier Mvt
        } layout {
            sequence: 9
        } source {
            dataType: DATE
        } )

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }
            sort ( column: QTEPHYSIQUE; sort {
                sequence: 1
                direction: ASC
            } )
        )
        )

    pageItem P201_FILTER_SITE (
        type: hidden
        source {
        type: expression
        plsqlExpression: 'pkg_multisite_core.current_site'
    } )

)
