page 203 (
    name: Transferts en Cours
    alias: SM-TRANSFERTS-EN-COURS
    title: Mes Transferts en Cours
    pageGroup: @supermarche
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Tous les transferts où mon site est source (envoi vers dépôt) ou destination (réception).</p>
            <p>Cliquer sur un transfert EN_TRANSIT pour le réceptionner.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [ #DEFAULT# t-BreadcrumbRegion--useBreadcrumbTitle ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region transferts-recus (
        name: Transferts à Réceptionner (arrivage)
        type: interactiveReport
        source {
            location: localDatabase
            tableName: TES-TRANSFER
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P203_FILTER_DEST
        }
        link {
            linkColumn: customTarget
            target: { page: 204; items: {
                P204_ID: \#ID#\
            }; action: resetPagination }
            linkIcon: <span class="fa fa-truck"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucun transfert à réceptionner.
        }

        column ID (
            type: hidden
            layout {
            sequence: 0
        } source {
            primaryKey: true
            dataType: NUMBER
        } )
        column TRANSFER_NUM (
            type: plainText
            heading {
            heading: Numéro
        } layout {
            sequence: 1
        } source {
            dataType: STRING
        } )
        column SITE_SOURCE_ID (
            type: plainText
            heading {
            heading: Expéditeur
        } layout {
            sequence: 2
        } source {
            dataType: STRING
        } )
        column PRIORITY (
            type: plainText
            heading {
            heading: Prio
        } layout {
            sequence: 3
        } source {
            dataType: STRING
        } )
        column DATDEMANDE (
            type: plainText
            heading {
            heading: Demandé le
        } layout {
            sequence: 4
        } source {
            dataType: DATE
        } )
        column DATENVOI_EFFECTIVE (
            type: plainText
            heading {
            heading: Expédié le
        } layout {
            sequence: 5
        } source {
            dataType: DATE
        } )

        savedReport primary ( visibility: primaryDefault; view {
            rowsPerPage: 25
        } )
    )

    region transferts-envoyes (
        name: Transferts Envoyés (en attente)
        type: interactiveReport
        source {
            location: localDatabase
            tableName: TES-TRANSFER
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P203_FILTER_SRC
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucun transfert en attente côté envoi.
        }

        column ID (
            type: hidden
            layout {
            sequence: 0
        } source {
            primaryKey: true
            dataType: NUMBER
        } )
        column TRANSFER_NUM (
            type: plainText
            heading {
            heading: Numéro
        } layout {
            sequence: 1
        } source {
            dataType: STRING
        } )
        column SITE_DEST_ID (
            type: plainText
            heading {
            heading: Destinataire
        } layout {
            sequence: 2
        } source {
            dataType: STRING
        } )
        column ETAT (
            type: plainText
            heading {
            heading: État
        } layout {
            sequence: 3
        } source {
            dataType: STRING
        } )
        column PRIORITY (
            type: plainText
            heading {
            heading: Prio
        } layout {
            sequence: 4
        } source {
            dataType: STRING
        } )
        column DATDEMANDE (
            type: plainText
            heading {
            heading: Demandé le
        } layout {
            sequence: 5
        } source {
            dataType: DATE
        } )

        savedReport primary ( visibility: primaryDefault; view {
            rowsPerPage: 25
        } )
    )

    region historique (
        name: Historique Récent (7 derniers jours)
        type: interactiveReport
        source {
            location: localDatabase
            tableName: TES-TRANSFER
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--hideHeader ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucun transfert récent.
        }

        column ID (
            type: hidden
            layout {
            sequence: 0
        } source {
            primaryKey: true
            dataType: NUMBER
        } )
        column TRANSFER_NUM (
            type: plainText
            heading {
            heading: Numéro
        } layout {
            sequence: 1
        } source {
            dataType: STRING
        } )
        column SITE_SOURCE_ID (
            type: plainText
            heading {
            heading: Src
        } layout {
            sequence: 2
        } source {
            dataType: STRING
        } )
        column SITE_DEST_ID (
            type: plainText
            heading {
            heading: Dst
        } layout {
            sequence: 3
        } source {
            dataType: STRING
        } )
        column ETAT (
            type: plainText
            heading {
            heading: État
        } layout {
            sequence: 4
        } source {
            dataType: STRING
        } )
        column DATRECEPT_EFFECTIVE (
            type: plainText
            heading {
            heading: Réceptionné le
        } layout {
            sequence: 5
        } source {
            dataType: DATE
        } )

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 15
            }
            sort ( column: DATRECEPT_EFFECTIVE; sort {
                sequence: 1
                direction: DESC
            } )
        )
    )

    pageItem P203_FILTER_DEST (
        type: hidden
        source {
        type: expression
        plsqlExpression: 'pkg_multisite_core.current_site'
    } )
    pageItem P203_FILTER_SRC  (
        type: hidden
        source {
        type: expression
        plsqlExpression: 'pkg_multisite_core.current_site'
    } )
)
