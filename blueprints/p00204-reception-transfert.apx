page 204 (
    name: Réception Transfert
    alias: SM-RECEPTION-TRANSFERT
    title: Réceptionner un Transfert
    pageGroup: @supermarche
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [ #DEFAULT# js-dialog-class-t-Drawer--pullOutEnd ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Signalez la réception physique d'un transfert.</p>
            <p>Vérifiez le nombre de colis et indiquez l'état (conforme / partiel / non conforme / endommagé).</p>
            <p>Un commentaire est obligatoire en cas de non-conformité.</p>
            ```
    }

    region info-transfert (
        name: Informations Transfert
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_transfert_num VARCHAR2(20);
                    v_site_src_code VARCHAR2(20);
                    v_site_dst_code VARCHAR2(20);
                    v_etat          VARCHAR2(30);
                    v_nb_lignes     NUMBER;
                    v_total_qte     NUMBER;
                BEGIN
                    SELECT t.TRANSFER_NUM, src.SITE_CODE, dst.SITE_CODE, t.ETAT,
                           (SELECT COUNT(*) FROM "TES-TRANSFER-LINE" WHERE TRANSFER_ID=t.ID),
                           (SELECT NVL(SUM(QTEDEMANDEE),0) FROM "TES-TRANSFER-LINE" WHERE TRANSFER_ID=t.ID)
                      INTO v_transfert_num, v_site_src_code, v_site_dst_code, v_etat, v_nb_lignes, v_total_qte
                      FROM "TES-TRANSFER" t
                      JOIN "TES-SITE" src ON src.ID = t.SITE_SOURCE_ID
                      JOIN "TES-SITE" dst ON dst.ID = t.SITE_DEST_ID
                     WHERE t.ID = :P204_ID;

                    htp.p('<div class="u-info-grid">');
                    htp.p('<div><b>Transfert :</b> ' || v_transfert_num || '</div>');
                    htp.p('<div><b>De :</b> ' || v_site_src_code || ' <b>vers</b> ' || v_site_dst_code || '</div>');
                    htp.p('<div><b>État :</b> ' || v_etat || '</div>');
                    htp.p('<div><b>Lignes :</b> ' || v_nb_lignes || ' — Qté totale : ' || v_total_qte || '</div>');
                    htp.p('</div>');
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        htp.p('<div class="u-error">Transfert introuvable.</div>');
                END;
                ```
        }
    )

    region lignes-a-receptionner (
        name: Lignes à vérifier
        type: interactiveReport
        source {
            location: localDatabase
            tableName: TES-TRANSFER-LINE
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--scrollBody ]
        }
        pagination {
            type: noPagination
        }
        messages {
            whenNoDataFound: Aucune ligne.
        }

        column ID (
            type: hidden
            layout {
            sequence: 0
        } source {
            primaryKey: true
            dataType: NUMBER
        } )
        column TRANSFER_ID (
            type: hidden
            layout {
            sequence: 0
        } source {
            dataType: NUMBER
        } )
        column NUMLIG (
            type: plainText
            heading {
            heading: Lig
        } layout {
            sequence: 1
        } source {
            dataType: NUMBER
        } )
        column CODART (
            type: plainText
            heading {
            heading: Code Article
        } layout {
            sequence: 2
        } source {
            dataType: STRING
        } )
        column QTEDEMANDEE (
            type: plainText
            heading {
            heading: Demandé
            alignment: end
        } layout {
            sequence: 3
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTEPREPAREE (
            type: plainText
            heading {
            heading: Préparé
            alignment: end
        } layout {
            sequence: 4
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTEEXPEDIEE (
            type: plainText
            heading {
            heading: Expédié
            alignment: end
        } layout {
            sequence: 5
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )
        column QTERECEPTIONNEE (
            type: plainText
            heading {
            heading: Reçu
            alignment: end
        } layout {
            sequence: 6
            columnAlignment: end
        } appearance {
            formatMask: 999G990D000
        } source {
            dataType: NUMBER
        } )

        savedReport primary ( visibility: primaryDefault; view {
            rowsPerPage: 999
        } )
    )

    region reception-form (
        name: Saisie Réception
        type: form
        source {
            location: localDatabase
            tableName: TES-TRANSFER-RECEPTION
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [ add ]
        }
    )

    pageItem P204_TRANSFER_ID (
        type: hidden
        layout {
        sequence: 10
        region: @reception-form
        slot: regionBody
    } source {
        formRegion: @reception-form
        column: TRANSFER_ID
        dataType: number
    } )
    pageItem P204_RECEPTIONNE_PAR (
        type: textField
        label {
        label: Réceptionné par
        alignment: right
    } layout {
        sequence: 20
        region: @reception-form
        slot: regionBody
        alignment: left
    } appearance {
        template: @/optional-floating
        templateOptions: #DEFAULT#
        width: 60
    } validation {
        maxLength: 200
        required: true
    } source {
        formRegion: @reception-form
        column: RECEPTIONNE_PAR
        dataType: varchar2
    } )
    pageItem P204_COLIS_ATTENDUS (
        type: numberField
        label {
        label: Colis attendus
        alignment: right
    } layout {
        sequence: 30
        region: @reception-form
        slot: regionBody
        alignment: left
    } appearance {
        template: @/optional-floating
        templateOptions: #DEFAULT#
        width: 32
    } validation {
        required: true
    } source {
        formRegion: @reception-form
        column: NB_COLIS_ATTENDUS
        dataType: number
    } )
    pageItem P204_COLIS_RECUS (
        type: numberField
        label {
        label: Colis effectivement reçus
        alignment: right
    } layout {
        sequence: 40
        region: @reception-form
        slot: regionBody
        alignment: left
    } appearance {
        template: @/optional-floating
        templateOptions: #DEFAULT#
        width: 32
    } validation {
        required: true
    } source {
        formRegion: @reception-form
        column: NB_COLIS_RECUS
        dataType: number
    } )
    pageItem P204_ETAT_RECEPTION (
        type: radioGroup
        label {
        label: État de la réception
        alignment: right
    } layout {
        sequence: 50
        region: @reception-form
        slot: regionBody
        alignment: left
    } appearance {
        template: @/optional-floating
        templateOptions: #DEFAULT#
        width: 60
    } lov { staticValues: [
         {
            returnValue: CONFORME
            displayValue: Conforme - tout est OK
        }
         {
            returnValue: PARTIELLE
            displayValue: Partielle - écart de quantité
        }
         {
            returnValue: NON_CONFORME
            displayValue: Non conforme - produits manquants ou erronés
        }
         {
            returnValue: ENDOMMAGE
            displayValue: Endommagé - casse pendant transport
        }
    ] } source {
        formRegion: @reception-form
        column: ETAT_RECEPTION
        dataType: varchar2
    } validation {
        required: true
    } )
    pageItem P204_COMMENTAIRE (
        type: textarea
        label {
        label: Commentaire
        alignment: right
    } layout {
        sequence: 60
        region: @reception-form
        slot: regionBody
        alignment: left
    } appearance {
        template: @/optional-floating
        templateOptions: #DEFAULT#
        width: 60
        height: 4
    } validation {
        maxLength: 1000
    } source {
        formRegion: @reception-form
        column: COMMENTAIRE
        dataType: varchar2
    } serverSideCondition {
        type: expression
        plsqlExpression: ':P204_ETAT_RECEPTION IN (''PARTIELLE'',''NON_CONFORME'',''ENDOMMAGE'')'
    } )

    region buttons ( name: Buttons; type: staticContent; layout {
        sequence: 90
        slot: dialogFooter
    } appearance {
        template: @/buttons-container
        templateOptions: #DEFAULT#
    } )

    button cancel ( buttonName: CANCEL
        label: Annuler
        layout {
        sequence: 10
        region: @buttons
        slot: close
    } appearance {
        buttonTemplate: @/text
        templateOptions: #DEFAULT#
    } behavior {
        action: triggerAction
    } triggerAction native-dialog-cancel ( action: cancelDialog; execution {
        sequence: 10
    } ) )
    button confirm ( buttonName: CONFIRM
        label: Valider Réception
        layout {
        sequence: 20
        region: @buttons
        slot: next
    } appearance {
        buttonTemplate: @/text
        hot: true
        templateOptions: #DEFAULT#
    } behavior {
        warnOnUnsavedChanges: doNotCheck
    } )

    process confirm-reception (
        name: Confirm Reception
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    pkg_transfer.receive_transfer(
                        p_transfer_id     => :P204_TRANSFER_ID,
                        p_receptionne_par => :P204_RECEPTIONNE_PAR,
                        p_etat_reception  => :P204_ETAT_RECEPTION,
                        p_colis_attendus  => :P204_COLIS_ATTENDUS,
                        p_colis_recus     => :P204_COLIS_RECUS,
                        p_commentaire     => :P204_COMMENTAIRE
                    );
                    COMMIT;
                    htp.p('OK: Réception enregistrée');
                EXCEPTION
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20401, 'Erreur: ' || SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
    )

    process close-dialog ( name: Close Dialog; type: closeDialog; execution {
        sequence: 99
    } serverSideCondition {
        type: requestIsContainedInValue
        value: CONFIRM
    } )

)
