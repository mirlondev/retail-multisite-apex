page 101 (
    name: Liste des Sites
    alias: HQ-SITES-LIST
    title: Gestion des Sites
    pageGroup: @hq
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation { cursorFocus: doNotFocusCursor }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source { breadcrumb: @breadcrumb }
        layout { sequence: 5; slot: breadcrumbBar }
        appearance { template: @/title-bar; templateOptions: [ #DEFAULT# t-BreadcrumbRegion--useBreadcrumbTitle ] }
        componentAppearance { breadcrumbTemplate: @/breadcrumb; templateOptions: #DEFAULT# }
    )

    region sites-list (
        name: Sites
        type: interactiveReport
        source { location: localDatabase; tableName: "TES-SITE" }
        layout { sequence: 10; slot: body }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader
                js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: { page: 102; items: { P102_ID: \#ID#\ }; action: resetPagination }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit"></span>
        }
        pagination { type: rowRangesXToY }
        messages { whenNoDataFound: Aucun site configuré. Lancez _deploy_all.sql }

        column ID ( type: hidden; layout { sequence: 0 } source { primaryKey: true; dataType: NUMBER } )
        column SITE_CODE ( type: plainText; heading { heading: "Code" } layout { sequence: 10 } source { dataType: STRING } )
        column SITE_NAME ( type: plainText; heading { heading: "Nom" } layout { sequence: 20 } source { dataType: STRING } )
        column SITE_TYPE ( type: plainText; heading { heading: "Type" } layout { sequence: 30 } source { dataType: STRING } )
        column CITY ( type: plainText; heading { heading: "Ville" } layout { sequence: 40 } source { dataType: STRING } )
        column PHONE ( type: plainText; heading { heading: "Tél." } layout { sequence: 50 } source { dataType: STRING } )
        column ACTIVE ( type: plainText; heading { heading: "Actif" } layout { sequence: 60 } source { dataType: STRING } )

        savedReport primary (
            visibility: primaryDefault
            view { rowsPerPage: 25 }
            sort ( column: SITE_TYPE; sort { sequence: 1 } )
        )
    )

    button create-site (
        buttonName: CREATE
        label: Nouveau Site
        layout {
            sequence: 10
            region: @sites-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# }
        behavior {
            action: redirectThisApp
            target: { page: 102; clearCache: 102; items: { P102_ID: null } }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-closed (
        name: Edit Closed
        execution { sequence: 10 }
        when { event: apexafterclosedialog; selectionType: region; region: @sites-list }
        action native-refresh (
            action: refresh
            affectedElements { selectionType: region; region: @sites-list }
            execution { sequence: 10; fireOnInit: false }
        )
    )

    process set-site-context (
        name: Set Site Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    set_site_ctx_for_user(:APP_USER);
                END;
                ```
        }
        execution { sequence: 5; point: beforeHeader }
    )

)