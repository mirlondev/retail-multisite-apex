page 102 (
    name: Site Form
    title: Fiche Site
    pageGroup: @hq
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    region data (
        name: Fiche Site
        type: interactiveReport
        source {
            location: localDatabase
            tableName: "TES-SITE"
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucune donn?e disponible.
        }

        column SITE_CODE (
            type: plainText
            heading {
                heading: "Code"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column SITE_NAME (
            type: plainText
            heading {
                heading: "Nom"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column SITE_TYPE (
            type: plainText
            heading {
                heading: "Type"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column CITY (
            type: plainText
            heading {
                heading: "Ville"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )
    )
    process set-site-context (
        name: Set Site Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    set_site_ctx_for_user(:APP_USER);
                END;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

)
