page 110 (
    name: Magasin Form
    alias: HQ-MAGASIN-FORM
    title: Fiche Magasin / Dépôt
    pageGroup: @hq
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [ #DEFAULT# js-dialog-class-t-Drawer--pullOutEnd ]
    }
    dialog { chained: false }
    navigation { cursorFocus: doNotFocusCursor }
    security { pageAccessProtection: argumentsMustHaveChecksum; formAutoComplete: false }
    authorization { scheme: HQ_ADMIN_ONLY }

    region buttons ( name: Buttons; type: staticContent; layout { sequence: 20; slot: dialogFooter } appearance { template: @/buttons-container; templateOptions: #DEFAULT# } )

    region mag-form (
        name: Magasin
        type: form
        source { location: localDatabase; tableName: "TES-MAGASIN" }
        layout { sequence: 10; slot: contentBody }
        appearance { template: @/blank-with-attributes; templateOptions: #DEFAULT# }
        edit { enabled: true; allowedOperations: [ add update delete ] }
    )

    pageItem P110_ID ( type: hidden; layout { sequence: 10; region: @mag-form; slot: regionBody } source { formRegion: @mag-form; column: ID; dataType: number; queryOnly: true; primaryKey: true } security { sessionStateProtection: checksumRequiredSessionLevel } )
    pageItem P110_SITE_ID ( type: popupKeyLOV; label { label: "Site parent"; alignment: right } layout { sequence: 20; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } source { formRegion: @mag-form; column: SITE_ID; dataType: number; lov: { query: SELECT ID, SITE_CODE || ' - ' || SITE_NAME FROM "TES-SITE" WHERE ACTIVE='Y' ORDER BY SITE_TYPE, SITE_NAME } } validation { required: true } )
    pageItem P110_MAG_CODE ( type: textField; label { label: "Code Magasin"; alignment: right } layout { sequence: 30; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } validation { maxLength: 20; required: true } source { formRegion: @mag-form; column: MAG_CODE; dataType: varchar2 } )
    pageItem P110_MAG_NAME ( type: textField; label { label: "Nom"; alignment: right } layout { sequence: 40; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 200; required: true } source { formRegion: @mag-form; column: MAG_NAME; dataType: varchar2 } )
    pageItem P110_MAG_TYPE ( type: selectList; label { label: "Type"; alignment: right } layout { sequence: 50; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } lov { staticValues: [
        { returnValue: MAGASIN; displayValue: Magasin (SM) }
        { returnValue: DEPOT; displayValue: Dépôt }
        { returnValue: RAYON; displayValue: Rayon }
    ] } source { formRegion: @mag-form; column: MAG_TYPE; dataType: varchar2 } validation { required: true } )
    pageItem P110_SURFACE ( type: numberField; label { label: "Surface (m²)"; alignment: right } layout { sequence: 60; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } source { formRegion: @mag-form; column: SURFACE_M2; dataType: number } )
    pageItem P110_CAPACITY ( type: numberField; label { label: "Capacité stockage"; alignment: right } layout { sequence: 70; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } source { formRegion: @mag-form; column: CAPACITY; dataType: number } )
    pageItem P110_ADDR ( type: textField; label { label: "Adresse"; alignment: right } layout { sequence: 80; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 255 } source { formRegion: @mag-form; column: ADDRESS; dataType: varchar2 } )
    pageItem P110_RESP ( type: textField; label { label: "Responsable"; alignment: right } layout { sequence: 90; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 60 } validation { maxLength: 200 } source { formRegion: @mag-form; column: RESP_NAME; dataType: varchar2 } )
    pageItem P110_ACTIVE ( type: selectList; label { label: "Actif"; alignment: right } layout { sequence: 100; region: @mag-form; slot: regionBody; alignment: left } appearance { template: @/optional-floating; templateOptions: #DEFAULT#; width: 32 } lov { staticValues: [ { returnValue: Y; displayValue: Oui } { returnValue: N; displayValue: Non } ] } source { formRegion: @mag-form; column: ACTIVE; dataType: varchar2 } default { staticValue: Y } )

    button cancel ( buttonName: CANCEL; label: Annuler; layout { sequence: 10; region: @buttons; slot: close } appearance { buttonTemplate: @/text; templateOptions: #DEFAULT# } behavior { action: triggerAction } triggerAction native-dialog-cancel ( action: cancelDialog; execution { sequence: 10 } ) )
    button create ( buttonName: CREATE; label: Créer; layout { sequence: 40; region: @buttons; slot: next } appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# } behavior { warnOnUnsavedChanges: doNotCheck; databaseAction: insert } serverSideCondition { type: itemIsNull; item: P110_ID } )
    button delete ( buttonName: DELETE; label: Supprimer; layout { sequence: 20; region: @buttons; slot: delete } appearance { buttonTemplate: @/text; templateOptions: [ #DEFAULT# t-Button--danger t-Button--simple ] } behavior { executeValidations: false; warnOnUnsavedChanges: doNotCheck; databaseAction: delete; requiresConfirmation: true } confirmation { message: Supprimer ce magasin/dépôt ?; style: danger } serverSideCondition { type: itemIsNotNull; item: P110_ID } )
    button save ( buttonName: SAVE; label: Enregistrer; layout { sequence: 30; region: @buttons; slot: next } appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# } behavior { warnOnUnsavedChanges: doNotCheck; databaseAction: update } serverSideCondition { type: itemIsNotNull; item: P110_ID } )

    process close-dialog ( name: Close Dialog; type: closeDialog; execution { sequence: 50 } serverSideCondition { type: requestIsContainedInValue; value: CREATE,SAVE,DELETE } )
    process initialize-form ( name: Initialize form Magasin; type: formInitialization; formRegion: @mag-form; execution { sequence: 10; point: beforeHeader } )
    process process-form ( name: Process form Magasin; type: formAutoRowProcessing; formRegion: @mag-form; execution { sequence: 10 } )

)