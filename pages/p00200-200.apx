page 200 (
    name: SM Dashboard
    title: Tableau de Bord Magasin
    pageGroup: @supermarche
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    region data (
        name: Tableau de Bord Magasin
        type: interactiveReport
        source {
            location: localDatabase
            tableName: "TES-SITE"
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucune donn?e disponible.
        }

        column SITE_CODE (
            type: plainText
            heading {
                heading: "Code"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column SITE_NAME (
            type: plainText
            heading {
                heading: "Nom"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column SITE_TYPE (
            type: plainText
            heading {
                heading: "Type"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column CITY (
            type: plainText
            heading {
                heading: "Ville"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )
    )
)
