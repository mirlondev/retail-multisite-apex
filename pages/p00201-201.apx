page 201 (
    name: Stock Local
    alias: SM-STOCK-LOCAL
    title: Mon Stock
    pageGroup: @supermarche
    appearance { pageTemplate: @/standard; templateOptions: #DEFAULT# }
    navigation { cursorFocus: doNotFocusCursor }
    security { pageAccessProtection: argumentsMustHaveChecksum; formAutoComplete: false }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source { breadcrumb: @breadcrumb }
        layout { sequence: 5; slot: breadcrumbBar }
        appearance { template: @/title-bar; templateOptions: [ #DEFAULT# t-BreadcrumbRegion--useBreadcrumbTitle ] }
        componentAppearance { breadcrumbTemplate: @/breadcrumb; templateOptions: #DEFAULT# }
    )

    region kpi-stock (
        name: Résumé Stock Mon Site
        type: staticContent
        layout { sequence: 10; slot: body }
        appearance { template: @/blank-with-attributes; templateOptions: #DEFAULT# }
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_refs     NUMBER := 0;
                    v_ruptures NUMBER := 0;
                    v_alertes  NUMBER := 0;
                BEGIN
                    SELECT COUNT(*),
                           SUM(CASE WHEN NVL(QTEPHYSIQUE,0) <= 0 THEN 1 ELSE 0 END),
                           SUM(CASE WHEN NVL(QTEPHYSIQUE,0) > 0 AND NVL(QTEPHYSIQUE,0) <= NVL(QTEMIN, NVL(QTESEC,0)) THEN 1 ELSE 0 END)
                      INTO v_refs, v_ruptures, v_alertes
                      FROM "TES-STOCK-SITE"
                     WHERE SITE_ID = SITE_CTX;
                    htp.p('<div class="u-info-grid">');
                    htp.p('  <div class="kpi"><b>' || v_refs || '</b><br>références stock</div>');
                    htp.p('  <div class="kpi" style="color:red"><b>' || v_ruptures || '</b><br>en rupture</div>');
                    htp.p('  <div class="kpi" style="color:orange"><b>' || v_alertes || '</b><br>alertes min</div>');
                    htp.p('</div>');
                END;
                ```
        }
    )

    region stock-local (
        name: Mon Stock
        type: interactiveReport
        source { location: localDatabase; tableName: "TES-STOCK-SITE" }
        layout { sequence: 20; slot: body }
        appearance {
            template: @/interactive-report
            templateOptions: [ #DEFAULT# t-IRR-region--hideHeader ]
        }
        link {
            linkColumn: customTarget
            target: { page: 207; items: { P207_ID: \#ID#\ }; action: resetPagination }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit"></span>
        }
        pagination { type: rowRangesXToY }
        messages { whenNoDataFound: Aucune référence en stock. }

        column ID ( type: hidden; layout { sequence: 0 } source { primaryKey: true; dataType: NUMBER } )
        column CODART ( type: plainText; heading { heading: "Article" } layout { sequence: 10 } source { dataType: STRING } )
        column QTEPHYSIQUE ( type: plainText; heading { heading: "Phys."; alignment: end } layout { sequence: 20; columnAlignment: end } source { dataType: NUMBER } )
        column QTETHEORIQUE ( type: plainText; heading { heading: "Théo."; alignment: end } layout { sequence: 30; columnAlignment: end } source { dataType: NUMBER } )
        column QTEENTRANSIT ( type: plainText; heading { heading: "Transit"; alignment: end } layout { sequence: 40; columnAlignment: end } source { dataType: NUMBER } )
        column QTEMIN ( type: plainText; heading { heading: "Min"; alignment: end } layout { sequence: 50; columnAlignment: end } source { dataType: NUMBER } )

        savedReport primary (
            visibility: primaryDefault
            view { rowsPerPage: 50 }
            sort ( column: CODART; sort { sequence: 1 } )
        )
    )

    button create-stock (
        buttonName: CREATE
        label: Ajouter Référence
        layout {
            sequence: 10
            region: @stock-local
            slot: rightOfInteractiveReportSearchBar
        }
        appearance { buttonTemplate: @/text; hot: true; templateOptions: #DEFAULT# }
        behavior {
            action: redirectThisApp
            target: { page: 207; clearCache: 207; items: { P207_ID: null } }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-closed (
        name: Edit Closed
        execution { sequence: 10 }
        when { event: apexafterclosedialog; selectionType: region; region: @stock-local }
        action native-refresh (
            action: refresh
            affectedElements { selectionType: region; region: @stock-local }
            execution { sequence: 10; fireOnInit: false }
        )
    )

)