page 202 (
    name: Demande R?appro
    title: Demande R?approvisionnement
    pageGroup: @supermarche
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    region data (
        name: Demande R?approvisionnement
        type: interactiveReport
        source {
            location: localDatabase
            tableName: "TES-TRANSFER"
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucune donn?e disponible.
        }

        column TRANSFER_NUM (
            type: plainText
            heading {
                heading: "Transfert"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column SITE_SOURCE_ID (
            type: plainText
            heading {
                heading: "Source"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column SITE_DEST_ID (
            type: plainText
            heading {
                heading: "Destination"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column ETAT (
            type: plainText
            heading {
                heading: "?tat"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )
    )
    process set-site-context (
        name: Set Site Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    set_site_ctx_for_user(:APP_USER);
                END;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

)
